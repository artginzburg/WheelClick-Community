    "Included with a license. %@ and %@ on the trackpad stay free, forever.": {
      "comment": "Note on the hover card of a locked (paid) menu item; the two placeholders are gesture names, e.g. 'Three-Finger Click' and 'Three-Finger Tap'",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Lizenz enthalten. „%@“ und „%@“ auf dem Trackpad bleiben kostenlos, für immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Included with a license. %1$@ and %2$@ on the trackpad stay free, forever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluido con una licencia. %@ y %@ en el trackpad siguen siendo gratis, para siempre."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluido con una licencia. %@ y %@ en el trackpad siguen siendo gratis, para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclus avec une licence. %@ et %@ sur le trackpad restent gratuits, pour toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso nella licenza. %@ e %@ sul trackpad restano gratuiti, per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスに含まれます。トラックパッドの%@と%@は永久に無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스에 포함됩니다. 트랙패드의 %@ 및 %@ 기능은 영원히 무료입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część licencji. %@ i %@ na gładziku pozostają bezpłatne, na zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluído na licença. %@ e %@ no trackpad continuam grátis, para sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входит в лицензию. %@ и %@ на трекпаде остаются бесплатными, навсегда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisansa dahildir. İzleme dörtgeninde %@ ve %@ sonsuza dek ücretsiz kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Входить до ліцензії. %@ і %@ на трекпеді залишаються безкоштовними назавжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có trong giấy phép. %@ và %@ trên bàn di chuột vẫn miễn phí, vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可证包含此项。触控板上的%@和%@永远免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權包含此項。觸控式軌跡板上的%@和%@永遠免費。"
          }
        }
      }
    },
