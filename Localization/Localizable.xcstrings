    "%@ enters a Windows-style scroll mode instead of a middle click.": {
      "comment": "First paragraph of an Autoscroll choice's hover card; placeholder is a gesture name such as 'Three-Finger Click'",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ startet statt eines Mittelklicks einen Scrollmodus wie unter Windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entra en un modo de desplazamiento al estilo de Windows en lugar de hacer un clic central."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entra en un modo de desplazamiento al estilo de Windows en lugar de hacer un clic central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ passe en mode de défilement façon Windows au lieu d’un clic central."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ attiva una modalità di scorrimento in stile Windows invece di un clic centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は中クリックの代わりに、Windows風のスクロールモードに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 제스처가 가운데 클릭 대신 Windows 방식의 스크롤 모드로 들어갑니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ włącza tryb przewijania w stylu Windows zamiast kliknięcia środkowym przyciskiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entra em um modo de rolagem ao estilo do Windows em vez de fazer um clique central."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ включает режим прокрутки, как в Windows, вместо среднего клика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, orta tıklama yerine Windows tarzı kaydırma moduna girer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вмикає прокручування в стилі Windows замість середнього клацання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ vào chế độ cuộn kiểu Windows thay vì bấm chuột giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@将进入 Windows 风格的滚动模式，而不是中键点按。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@會進入 Windows 風格的捲動模式，而不是中鍵點按。"
          }
        }
      }
    },
    "%@ is off — turn it on above for this to fire.": {
      "comment": "Warning on an Autoscroll choice's hover card; placeholder is a gesture name such as 'Three-Finger Click', switched off in the main menu",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist aus – schalte die Geste oben ein, damit das hier greift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivado: actívalo arriba para que esto funcione."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desactivado: actívalo arriba para que esto funcione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est désactivé — activez-le ci-dessus pour que ceci se déclenche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è disattivato: attivalo qui sopra perché questo funzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はオフです。これを動かすには、上でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 제스처가 꺼져 있습니다. 이 기능이 작동하려면 위에서 켜십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest wyłączone — włącz je powyżej, aby to zadziałało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está desativado — ative acima para que isto funcione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выключено — включите выше, чтобы это срабатывало."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kapalı — bunun çalışması için yukarıdan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вимкнено — увімкніть вище, щоб це спрацювало."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang tắt — hãy bật ở phía trên để tính năng này hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已关闭，请先在上方开启，此项才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已關閉，請先在上方開啟，此項才會生效。"
          }
        }
      }
    },
    "%@ · assumes %lld h of trackpad use a day": {
