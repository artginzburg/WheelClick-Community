          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng phía trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最前方的 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最前方的 App"
          }
        }
      }
    },
    "Gestures that go beyond a middle click.\nAll off by default, except %@.": {
      "comment": "Gray caption at the top of the Plugins submenu. The placeholder is a gesture name such as 'fn+Click'. The line break is manual (the menu widens rather than wraps)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesten, die über einen Mittelklick hinausgehen.\nStandardmäßig alle aus, außer „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos que van más allá de un clic central.\nTodos desactivados por omisión, salvo %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos que van más allá de un clic central.\nTodos desactivados de forma predeterminada, salvo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des gestes qui vont au-delà du clic central.\nTous désactivés par défaut, sauf %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesti che vanno oltre il clic centrale.\nTutti disattivati all’inizio, tranne %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中クリックの先にあるジェスチャ。\n%@を除き、デフォルトではすべてオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 클릭을 넘어서는 제스처.\n%@ 외에는 모두 기본적으로 꺼져 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesty wykraczające poza kliknięcie środkowym przyciskiem.\nDomyślnie wszystkie wyłączone — wyjątek: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestos que vão além do clique central.\nTodos desativados por padrão, exceto %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты, которые идут дальше среднего клика.\nВсе выключены по умолчанию, кроме %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta tıklamanın ötesine geçen hareketler.\n%@ dışında hepsi saptanmış olarak kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жести, що виходять за межі середнього клацання.\nУсі типово вимкнені, крім %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những cử chỉ vượt ra ngoài bấm chuột giữa.\nTất cả đều tắt theo mặc định, trừ %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超越中键点按的手势。\n默认全部关闭，%@除外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超越中鍵點按的手勢。\n預設全部關閉，%@除外。"
          }
        }
      }
    },
