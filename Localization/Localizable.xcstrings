            "value": "我要在滑鼠上用，不是觸控式軌跡板"
          }
        }
      }
    },
    "I thought I'd have to pay": {
      "comment": "Answer button in the 'Why are you quitting WheelClick?' alert",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich dachte, ich müsste zahlen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creía que tendría que pagar"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Creía que tendría que pagar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pensais devoir payer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensavo di dover pagare"
