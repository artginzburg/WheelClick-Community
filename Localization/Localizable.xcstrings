        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave ya está activa en su número máximo de Mac. Desactiva uno en el portal del cliente e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave ya está activa en su número máximo de Mac. Desactiva una en el portal del cliente e inténtalo de nuevo."
