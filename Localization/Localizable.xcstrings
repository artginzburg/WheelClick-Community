    },
    "The checkout opens in your browser and activates WheelClick by itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf öffnet sich in deinem Browser und aktiviert WheelClick von selbst."
          }
        },
        "es": {
