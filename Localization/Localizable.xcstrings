    "Couldn't reach the store to activate — check your connection and click the activation link again.": {
      "comment": "Purchase window error after an activation link failed: no connection to the license store",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Store war zum Aktivieren nicht erreichbar – prüfe deine Verbindung und klicke den Aktivierungslink erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con la tienda para activar; comprueba tu conexión y vuelve a hacer clic en el enlace de activación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con la tienda para activar; revisa tu conexión y vuelve a hacer clic en el enlace de activación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre la boutique pour l’activation — vérifiez votre connexion et cliquez de nouveau sur le lien d’activation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere lo store per l’attivazione: controlla la connessione e fai di nuovo clic sul link di attivazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアに接続できず、アクティベートできませんでした。接続を確認して、アクティベーションリンクをもう一度クリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화를 위해 스토어에 연결할 수 없습니다. 연결 상태를 확인하고 활성화 링크를 다시 클릭하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć ze sklepem, aby aktywować — sprawdź połączenie i kliknij link aktywacyjny ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar à loja para ativar — verifique sua conexão e clique no link de ativação de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с магазином для активации — проверьте соединение и нажмите ссылку активации еще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirme için mağazaya ulaşılamadı — bağlantınızı denetleyip etkinleştirme bağlantısına yeniden tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися з магазином для активації — перевірте з’єднання й клацніть посилання для активації ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được với cửa hàng để kích hoạt — hãy kiểm tra kết nối rồi bấm lại liên kết kích hoạt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接商店进行激活，请检查网络连接，然后再次点按激活链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至商店進行啟用，請檢查網路連線，然後再按一下啟用連結。"
          }
        }
      }
    },
