        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello è un clic destro. Tre dita, ricordi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それは右クリックです。3本指、覚えていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그건 오른쪽 클릭입니다. 세 손가락, 기억하시죠?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To prawe kliknięcie. Trzy palce, pamiętasz?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é um clique direito. Três dedos, lembra?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это правый клик. Три пальца, помните?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir sağ tıklama. Üç parmak, hatırlıyorsunuz değil mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це праве клацання. Три пальці, пам’ятаєте?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là bấm chuột phải. Ba ngón tay, nhớ chứ?"
