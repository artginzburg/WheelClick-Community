    "In Allow mode, WheelClick works only in listed apps.": {
      "comment": "Hover card of the 'Allow <app>' menu item, explaining the current mode",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Erlauben-Modus funktioniert WheelClick nur in gelisteten Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo Permitir, WheelClick funciona solo en las apps de la lista."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo Permitir, WheelClick funciona solo en las apps de la lista."
          }
        },
