    "On your Magic Mouse, click its surface with three fingers. On any mouse, %@ is a middle click.": {
      "comment": "Alert text after answering 'I need it for a mouse'; the argument is a feature name, e.g. fn+Click",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deiner Magic Mouse: Klicke ihre Oberfläche mit drei Fingern. Auf jeder Maus ist „%@“ ein Mittelklick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Magic Mouse, haz clic en su superficie con tres dedos. En cualquier ratón, %@ es un clic central."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Magic Mouse, haz clic en su superficie con tres dedos. En cualquier mouse, %@ es un clic central."
