          }
        }
      }
    },
    "Click the mouse with one finger resting in the middle of its surface — the strip between the left- and right-click zones.": {
      "comment": "Hover card for the Magic Mouse item 'Click with One Finger in the Center'",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke die Maus, während ein Finger mitten auf ihrer Oberfläche liegt – auf dem Streifen zwischen Linksklick- und Rechtsklick-Zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el ratón con un dedo apoyado en el centro de su superficie: la franja entre las zonas de clic izquierdo y derecho."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el mouse con un dedo apoyado en el centro de su superficie: la franja entre las zonas de clic izquierdo y derecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la souris avec un doigt posé au milieu de sa surface — la bande entre les zones de clic gauche et de clic droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul mouse con un dito appoggiato al centro della superficie: la striscia tra le zone del clic sinistro e del clic destro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウス表面の中央（左クリックと右クリックの領域の間の帯）に1本指を置いてクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락을 마우스 표면 가운데(왼쪽 클릭 영역과 오른쪽 클릭 영역 사이의 띠)에 올려 둔 채 클릭합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij jednym palcem spoczywającym na środku powierzchni myszy — w pasie między strefami lewego i prawego kliknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no mouse com um dedo apoiado no meio da superfície — a faixa entre as zonas de clique esquerdo e direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на мышь одним пальцем, лежащим посередине ее поверхности — на полоске между зонами левого и правого нажатия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir parmağınız yüzeyin ortasında — sol ve sağ tıklama bölgelerinin arasındaki şeritte — dururken fareye tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть мишею, тримаючи один палець посередині її поверхні — на смужці між зонами лівого й правого клацання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột với một ngón tay đặt ở giữa mặt chuột — dải nằm giữa vùng bấm trái và bấm phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指停在鼠标表面中央（左键区与右键区之间的那条带）并点按。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單指停在滑鼠表面中央（左鍵區與右鍵區之間的那條帶）並按一下。"
          }
        }
      }
    },
    "Click the mouse with three fingers resting on its surface — the mouse twin of the trackpad's Three-Finger Click.": {
      "comment": "Hover card for the Magic Mouse item 'Click with Three Fingers'; 'Three-Finger Click' is the name of WheelClick's trackpad gesture",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke die Maus, während drei Finger auf ihrer Oberfläche liegen – das Maus-Gegenstück zum „Klick mit drei Fingern“ des Trackpads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el ratón con tres dedos apoyados en su superficie: el gemelo para ratón del Clic con tres dedos del trackpad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el mouse con tres dedos apoyados en su superficie: el gemelo para mouse del Clic con tres dedos del trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la souris avec trois doigts posés sur sa surface — le jumeau souris du Clic à trois doigts du trackpad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul mouse con tre dita appoggiate sulla superficie: il gemello per mouse del Clic con tre dita del trackpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの表面に3本指を置いてクリックします。トラックパッドの「3本指クリック」のマウス版です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 손가락을 마우스 표면에 올려 둔 채 클릭합니다. 트랙패드의 세 손가락 클릭에 해당하는 마우스 버전입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, trzymając trzy palce na powierzchni myszy — mysi odpowiednik gestu Kliknięcie trzema palcami na gładziku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no mouse com três dedos apoiados na superfície — o irmão gêmeo do Clique com Três Dedos do trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на мышь тремя пальцами, лежащими на ее поверхности — двойник трекпадного «Нажатия тремя пальцами»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç parmağınız yüzeyinde dururken fareye tıklayın — izleme dörtgenindeki Üç Parmakla Tıklama’nın fare ikizi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть мишею, тримаючи три пальці на її поверхні — мишачий відповідник Клацання трьома пальцями на трекпеді."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột với ba ngón tay đặt trên mặt chuột — bản dành cho chuột của Bấm bằng ba ngón tay trên bàn di chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三指搭在鼠标表面并点按——触控板“三指点按”的鼠标版。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三指放在滑鼠表面並按一下，是觸控式軌跡板「三指按一下」的滑鼠版。"
          }
        }
      }
    },
    "Click the mouse with two fingers resting on its surface. Off by default: resting index and middle finger while clicking is a common grip.": {
      "comment": "Hover card for the Magic Mouse item 'Click with Two Fingers'",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke die Maus, während zwei Finger auf ihrer Oberfläche liegen. Standardmäßig aus: Zeige- und Mittelfinger beim Klicken aufzulegen ist ein verbreiteter Griff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el ratón con dos dedos apoyados en su superficie. Desactivado por omisión: apoyar el índice y el corazón al hacer clic es un agarre habitual."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el mouse con dos dedos apoyados en su superficie. Desactivado de forma predeterminada: apoyar el índice y el dedo medio al hacer clic es un agarre habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la souris avec deux doigts posés sur sa surface. Désactivé par défaut : poser l’index et le majeur en cliquant est une prise courante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul mouse con due dita appoggiate sulla superficie. Disattivato per impostazione predefinita: tenere indice e medio appoggiati mentre si fa clic è una presa comune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの表面に2本指を置いてクリックします。デフォルトではオフ：人差し指と中指を置いたままクリックするのはよくある持ち方だからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락을 마우스 표면에 올려 둔 채 클릭합니다. 기본적으로 꺼져 있습니다: 검지와 중지를 올려 둔 채 클릭하는 것은 흔한 잡는 방식이기 때문입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, trzymając dwa palce na powierzchni myszy. Domyślnie wyłączone: palec wskazujący i środkowy oparte podczas klikania to częsty chwyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no mouse com dois dedos apoiados na superfície. Desativado por padrão: apoiar o indicador e o dedo médio ao clicar é um jeito comum de segurar o mouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на мышь двумя пальцами, лежащими на ее поверхности. По умолчанию выключено: держать указательный и средний пальцы на мыши при нажатии — распространенный хват."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki parmağınız yüzeyinde dururken fareye tıklayın. Saptanmış olarak kapalı: tıklarken işaret ve orta parmağı yüzeyde tutmak yaygın bir kavrayıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть мишею, тримаючи два пальці на її поверхні. Типово вимкнено: тримати вказівний і середній пальці на миші під час клацання — звичний хват."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột với hai ngón tay đặt trên mặt chuột. Tắt theo mặc định: đặt ngón trỏ và ngón giữa khi bấm là cách cầm chuột rất phổ biến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指搭在鼠标表面并点按。默认关闭：点按时食指和中指同时搭在鼠标上是很常见的握法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩指放在滑鼠表面並按一下。預設關閉：按一下時食指和中指同時放在滑鼠上是很常見的握法。"
          }
        }
      }
    },
