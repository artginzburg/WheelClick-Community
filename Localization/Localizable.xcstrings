        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una app, o una herramienta de línea de comandos para tratarla como tal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une app — ou un outil en ligne de commande à traiter comme telle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’app, o uno strumento da riga di comando da trattare come tale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを選択してください。アプリとして扱うコマンドラインツールでも構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 선택하거나, 앱으로 취급할 명령어 도구를 선택하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację — albo narzędzie wiersza poleceń, które ma być traktowane jak aplikacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um app — ou uma ferramenta de linha de comando para tratar como um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложение — или инструмент командной строки, чтобы считать его приложением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulama seçin — ya da uygulama gibi ele alınacak bir komut satırı aracı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть програму — або інструмент командного рядка, який вважатиметься програмою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một ứng dụng — hoặc một công cụ dòng lệnh để coi như ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个 App，或一个要当作 App 对待的命令行工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個 App，或選擇一個當作 App 處理的命令列工具。"
          }
        }
      }
    },
    "Choose from File…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Datei wählen…"
          }
        },
        "es": {
