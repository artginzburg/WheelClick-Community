          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preciso dele para um mouse, não para o trackpad"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне нужно для мыши, а не для трекпада"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleme dörtgeni değil, fare için gerekiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мені потрібно для миші, а не для трекпеда"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi cần cho chuột, không phải bàn di chuột"
