    "Hold %@ and click for a middle click — trackpad or mouse, and keep holding for a middle-button drag.": {
      "comment": "Hover card of a modifier-key choice in the 'Choose Modifier' submenu; placeholder is a key symbol such as ⌘ or fn",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@ und klicke für einen Mittelklick – auf Trackpad oder Maus; halte weiter gedrückt, um mit der mittleren Taste zu ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ y haz clic para un clic central, en el trackpad o el ratón; sigue manteniéndola para arrastrar con el botón central."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ y haz clic para un clic central, en el trackpad o el mouse; sigue manteniéndola para arrastrar con el botón central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ et cliquez pour un clic central — trackpad ou souris ; continuez à maintenir pour un glissement au bouton central."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ e fai clic per un clic centrale, con trackpad o mouse; continua a tenerlo premuto per trascinare con il tasto centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押しながらクリックすると中クリック。トラックパッドでもマウスでも。押したままにすれば中ボタンドラッグになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 키를 누른 채 클릭하면 가운데 클릭이 됩니다. 트랙패드든 마우스든 마찬가지이고, 계속 누르고 있으면 가운데 버튼 드래그가 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@ i kliknij, aby uzyskać kliknięcie środkowym przyciskiem — na gładziku lub myszy; trzymaj dalej, aby przeciągać środkowym przyciskiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ e clique para um clique central — no trackpad ou no mouse; continue segurando para arrastar com o botão central."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@ и нажмите — средний клик на трекпаде или мыши; держите дальше — перетягивание средней кнопкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta tıklama için %@ tuşunu basılı tutup tıklayın — izleme dörtgeni ya da fare; orta tuşla sürüklemek için basılı tutmayı sürdürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@ і клацніть — середнє клацання на трекпеді чи миші; тримайте далі, щоб перетягувати середньою кнопкою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ %@ và bấm để bấm chuột giữa — trên bàn di chuột hay chuột đều được; tiếp tục giữ để kéo bằng nút giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@ 并点按即为中键点按，触控板或鼠标皆可；继续按住可进行中键拖移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@ 並按一下即為中鍵點按，觸控式軌跡板或滑鼠皆可；繼續按住可進行中鍵拖移。"
          }
        }
      }
    },
    "Hold %@ and click — any button, any device. Keep holding to drag, which is Blender's “Emulate 3 Button Mouse”. Hold ⌥ in the menu for another key.": {
      "comment": "Description card for the fn+Click menu item; the argument is the modifier key's symbol, e.g. fn. “Emulate 3 Button Mouse” is the name of a setting in Blender",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@ und klicke – jede Taste, jedes Gerät. Halte weiter gedrückt, um zu ziehen – das ist Blenders „Emulate 3 Button Mouse“. Halte ⌥ im Menü für eine andere Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ y haz clic: cualquier botón, cualquier dispositivo. Sigue manteniéndola para arrastrar, que es el “Emulate 3 Button Mouse” de Blender. Mantén ⌥ en el menú para elegir otra tecla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ y haz clic: cualquier botón, cualquier dispositivo. Sigue manteniéndola para arrastrar, que es el “Emulate 3 Button Mouse” de Blender. Mantén ⌥ en el menú para elegir otra tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ et cliquez — n’importe quel bouton, n’importe quel appareil. Continuez à maintenir pour faire glisser, soit l’« Emulate 3 Button Mouse » de Blender. Maintenez ⌥ dans le menu pour une autre touche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ e fai clic: qualsiasi tasto, qualsiasi dispositivo. Continua a tenerlo premuto per trascinare, come “Emulate 3 Button Mouse” di Blender. Tieni premuto ⌥ nel menu per scegliere un altro tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押しながらクリック。どのボタン、どのデバイスでも。押したままにすればドラッグ、つまりBlenderの「3ボタンマウスをエミュレート」です。メニューで⌥を押したままにすると別のキーを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 키를 누른 채 클릭하십시오. 어떤 버튼, 어떤 기기든 됩니다. 계속 누르고 있으면 드래그가 되며, 이것이 Blender의 ‘Emulate 3 Button Mouse’입니다. 다른 키를 쓰려면 메뉴에서 ⌥을 누른 채 유지하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@ i kliknij — dowolnym przyciskiem, na dowolnym urządzeniu. Trzymaj dalej, aby przeciągać, czyli „Emulate 3 Button Mouse” z Blendera. Przytrzymaj ⌥ w menu, aby wybrać inny klawisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ e clique — qualquer botão, qualquer dispositivo. Continue segurando para arrastar, que é o “Emulate 3 Button Mouse” do Blender. Segure ⌥ no menu para escolher outra tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@ и нажмите — любой кнопкой, на любом устройстве. Держите дальше, чтобы перетягивать: это «Emulate 3 Button Mouse» из Blender. Удерживайте ⌥ в меню, чтобы выбрать другую клавишу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tuşunu basılı tutup tıklayın — herhangi bir tuş, herhangi bir aygıt. Sürüklemek için basılı tutmayı sürdürün; bu, Blender’ın “Emulate 3 Button Mouse” özelliğidir. Başka bir tuş için menüde ⌥ tuşunu basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@ і клацніть — будь-якою кнопкою, на будь-якому пристрої. Тримайте далі, щоб перетягувати — це «Emulate 3 Button Mouse» з Blender. Утримуйте ⌥ у меню, щоб вибрати іншу клавішу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ %@ và bấm — nút nào, thiết bị nào cũng được. Tiếp tục giữ để kéo, chính là “Emulate 3 Button Mouse” của Blender. Giữ ⌥ trong menu để chọn phím khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@ 并点按，任何按键、任何设备都行。继续按住即可拖移，也就是 Blender 的“模拟 3 键鼠标”。在菜单中按住 ⌥ 可换用其他键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@ 並按一下，任何按鈕、任何裝置都行。繼續按住即可拖移，也就是 Blender 的「模擬三鍵滑鼠」。在選單中按住 ⌥ 可換用其他鍵。"
          }
        }
      }
    },
    "Hold three fingers still, then slide: middle-button down, drag while held, up on lift.": {
      "comment": "Hover card for the Tap-Hold Three Fingers menu item in Plugins > Middle-Drag; 'middle-button' = the middle mouse button",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Finger ruhig halten, dann gleiten: mittlere Taste runter, ziehen solange gehalten, hoch beim Abheben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tres dedos quietos y luego deslízalos: botón central pulsado, arrastre mientras lo mantienes, y se suelta al levantarlos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tres dedos quietos y luego deslízalos: botón central presionado, arrastre mientras lo mantienes, y se suelta al levantarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez trois doigts immobiles, puis glissez : bouton central enfoncé, glissement tant que vous maintenez, relâché quand vous levez les doigts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni tre dita ferme, poi fai scorrere: tasto centrale premuto, trascinamento finché lo tieni, rilascio quando sollevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指を置いて静止し、そのままスライド：中ボタンを押し、押している間ドラッグ、離すと放します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 손가락을 잠시 멈춘 뒤 미십니다: 가운데 버튼이 눌리고, 누른 동안 드래그되며, 손가락을 떼면 버튼이 올라갑니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj trzy palce nieruchomo, potem przesuń: środkowy przycisk zostaje wciśnięty, przeciągasz, dopóki trzymasz, a puszczasz, unosząc palce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha três dedos parados e então deslize: pressiona o botão central, arrasta enquanto você segura e solta ao levantar os dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержите три пальца неподвижно, затем ведите: средняя кнопка нажимается, перетягивание — пока держите, отпускается при подъеме."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç parmağınızı sabit tutun, sonra kaydırın: orta tuş basılır, tuttuğunuz sürece sürükler, parmakları kaldırınca bırakılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потримайте три пальці нерухомо, потім ведіть: середня кнопка натискається, перетягує, поки тримаєте, і відпускається, коли підіймете пальці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ yên ba ngón tay, rồi trượt: nút giữa được nhấn xuống, kéo trong lúc giữ, nhả khi nhấc tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三指按住不动，然后滑动：按下中键，按住时拖移，抬起时松开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三指按住不動，然後滑動：按下中鍵，按住時拖移，抬起時放開。"
          }
        }
      }
    },
    "Hold ⌥ for Configure — manage every list and how the active app is detected.": {
      "comment": "Footnote on the 'Ignore/Allow <app>' hover card; ⌥ is the Option key, which reveals the 'Configure allowed apps…' menu item",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌥ für „Konfigurieren“ – verwalte alle Listen und wie die aktive App erkannt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌥ para Configurar: gestiona todas las listas y cómo se detecta la app activa."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌥ para Configurar: administra todas las listas y cómo se detecta la app activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥ pour Configurer — gérez toutes les listes et la façon dont l’app active est détectée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌥ per Configura: gestisci tutti gli elenchi e il modo in cui viene rilevata l’app attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥を押したままにすると「設定」が現れ、すべてのリストとアクティブなアプリの判定方法を管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥을 누른 채 유지하면 구성 메뉴가 나타납니다. 모든 목록과 활성 앱 인식 방식을 관리할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj ⌥, aby otworzyć konfigurację — zarządzaj wszystkimi listami i sposobem wykrywania aktywnej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌥ para Configurar — gerencie todas as listas e como o app ativo é detectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌥ для настройки — все списки и способ определения активного приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlamak için ⌥ tuşunu basılı tutun — tüm listeleri ve etkin uygulamanın nasıl algılandığını yönetin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте ⌥ для налаштування — керуйте всіма списками й тим, як визначається активна програма."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ ⌥ để mở Cấu hình — quản lý mọi danh sách và cách nhận diện ứng dụng đang hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 显示“配置”，可管理所有列表以及活跃 App 的检测方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 顯示「設定」，可管理所有列表以及使用中 App 的偵測方式。"
          }
        }
      }
    },
    "I need it for a mouse, not the trackpad": {
      "comment": "Answer button in the 'Why are you quitting WheelClick?' alert",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich brauche es für eine Maus, nicht fürs Trackpad"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo necesito para un ratón, no para el trackpad"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo necesito para un mouse, no para el trackpad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’en ai besoin pour une souris, pas le trackpad"
