            "value": "Ödeme yapmam gerekeceğini sanmıştım"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здавалося, що треба платити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
