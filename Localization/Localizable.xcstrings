    "Slide three fingers up or down to change the display brightness.": {
      "comment": "Hover card for the Brightness choice under Plugins > Three-Finger Swipe",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleite mit drei Fingern nach oben oder unten, um die Bildschirmhelligkeit zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza tres dedos hacia arriba o hacia abajo para cambiar el brillo de la pantalla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza tres dedos hacia arriba o hacia abajo para cambiar el brillo de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez trois doigts vers le haut ou le bas pour régler la luminosité de l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai scorrere tre dita verso l’alto o il basso per regolare la luminosità dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指で上下にスライドして、ディスプレイの明るさを変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 손가락을 위아래로 밀어 디스플레이 밝기를 바꿉니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń trzy palce w górę lub w dół, aby zmienić jasność ekranu."
