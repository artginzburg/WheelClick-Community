    "Middle click! Opened in a new tab.": {
      "comment": "Onboarding playground success message after middle-clicking a pretend link",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelklick! In neuem Tab geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Clic central! Abierto en una pestaña nueva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Clic central! Abierto en una pestaña nueva."
          }
        },
        "fr": {
