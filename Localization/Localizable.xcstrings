          }
        }
      }
    },
    "On any mouse, %@ is a middle click.": {
      "comment": "Alert text after answering 'I need it for a mouse'; the argument is a feature name, e.g. fn+Click",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeder Maus ist „%@“ ein Mittelklick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier ratón, %@ es un clic central."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier mouse, %@ es un clic central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur n’importe quelle souris, %@ fait un clic central."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su qualsiasi mouse, %@ è un clic centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのマウスでも、%@は中クリックです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 마우스에서나 %@ 제스처가 가운데 클릭이 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na każdej myszy %@ to kliknięcie środkowym przyciskiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qualquer mouse, %@ é um clique central."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На любой мыши %@ — это средний клик."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir farede %@ bir orta tıklamadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На будь-якій миші %@ — це середнє клацання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên bất kỳ chuột nào, %@ là bấm chuột giữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何鼠标上，%@都是中键点按。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何滑鼠上，%@都是中鍵點按。"
          }
        }
      }
    },
    "On any mouse, your Magic Mouse included, %@ is a middle click.": {
