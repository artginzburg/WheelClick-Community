    "During your trial you used %@. A license keeps it working.": {
      "comment": "Buy window, above the price: what one paid feature was used for during the trial. The argument is e.g. 'Force Click 25 times'; 'it' = that feature",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner Testphase kam %@ zum Einsatz. Mit einer Lizenz funktioniert das weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la prueba usaste %@. Una licencia hace que siga funcionando."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la prueba usaste %@. Una licencia hace que siga funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant votre essai, vous avez utilisé %@. Avec une licence, cela continue de fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la prova hai usato %@. Con una licenza continua a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル中の使用：%@。ライセンスがあれば引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간 동안 %@ 사용했습니다. 라이선스가 있으면 계속 작동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas okresu próbnego użyto: %@. Licencja pozwoli z tego korzystać dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante o teste você usou %@. Uma licença mantém isso funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За пробный период вы использовали %@. С лицензией так будет и дальше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme sürenizde kullandığınız: %@. Lisans bunun çalışmasını sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час пробного періоду ви використовували %@. З ліцензією ця функція працюватиме й далі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong thời gian thử, bạn đã dùng %@. Giấy phép giúp tính năng này tiếp tục hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用期间你使用了%@。许可证让它继续可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用期間你使用了%@。授權讓它繼續可用。"
          }
        }
      }
    },
    "During your trial you used %@. A license keeps them working.": {
      "comment": "Buy window, above the price: what two or three paid features were used for during the trial. The argument is a list like 'fn+Click 70 times and Force Click 33 times'; 'them' = those features",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner Testphase kamen %@ zum Einsatz. Mit einer Lizenz funktionieren sie weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la prueba usaste %@. Una licencia hace que sigan funcionando."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la prueba usaste %@. Una licencia hace que sigan funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant votre essai, vous avez utilisé %@. Avec une licence, tout cela continue de fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la prova hai usato %@. Con una licenza continuano a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル中の使用：%@。ライセンスがあればどれも引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간 동안 %@ 사용했습니다. 라이선스가 있으면 모두 계속 작동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas okresu próbnego użyto: %@. Licencja pozwoli z nich korzystać dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante o teste você usou %@. Uma licença mantém tudo isso funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За пробный период вы использовали %@. С лицензией так будет и дальше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme sürenizde kullandıklarınız: %@. Lisans bunların çalışmasını sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час пробного періоду ви використовували %@. З ліцензією ці функції працюватимуть і далі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong thời gian thử, bạn đã dùng %@. Giấy phép giúp các tính năng này tiếp tục hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用期间你使用了%@。许可证让它们继续可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用期間你使用了%@。授權讓它們繼續可用。"
          }
        }
      }
    },
