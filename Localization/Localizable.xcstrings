    "Anonymous usage statistics help improve WheelClick — they contain no personal data.": {
      "comment": "About window fine print above the usage statistics checkbox",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Nutzungsstatistiken helfen, WheelClick zu verbessern – sie enthalten keine persönlichen Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas de uso anónimas ayudan a mejorar WheelClick; no contienen datos personales."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas de uso anónimas ayudan a mejorar WheelClick; no contienen datos personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des statistiques d’utilisation anonymes aident à améliorer WheelClick — elles ne contiennent aucune donnée personnelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche d’uso anonime aiutano a migliorare WheelClick: non contengono dati personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名の使用統計はWheelClickの改善に役立ちます。個人データは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 사용 통계는 WheelClick을 개선하는 데 도움이 되며, 개인 정보는 포함하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimowe statystyki użycia pomagają ulepszać WheelClick — nie zawierają danych osobowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estatísticas anônimas de uso ajudam a melhorar o WheelClick — elas não contêm dados pessoais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимная статистика использования помогает улучшать WheelClick — в ней нет личных данных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonim kullanım istatistikleri WheelClick’i geliştirmeye yardımcı olur — kişisel veri içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонімна статистика використання допомагає покращувати WheelClick — особистих даних у ній немає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thống kê sử dụng ẩn danh giúp cải thiện WheelClick — không chứa dữ liệu cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名使用统计有助于改进 WheelClick，其中不含任何个人数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名使用統計資料有助於改進 WheelClick，其中不含任何個人資料。"
          }
        }
      }
    },
    "Anonymous usage statistics help improve WheelClick — they contain no personal data. Collecting them costs about %@ of energy a day — measured, like everything else.": {
      "comment": "About window fine print above the usage statistics checkbox; the argument is an energy amount in millijoules, e.g. '0.4 mJ'",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Nutzungsstatistiken helfen, WheelClick zu verbessern – sie enthalten keine persönlichen Daten. Ihre Erfassung kostet etwa %@ Energie pro Tag – gemessen, wie alles andere auch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas de uso anónimas ayudan a mejorar WheelClick; no contienen datos personales. Recopilarlas cuesta unos %@ de energía al día, medidos, como todo lo demás."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas de uso anónimas ayudan a mejorar WheelClick; no contienen datos personales. Recopilarlas cuesta unos %@ de energía al día, medidos, como todo lo demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des statistiques d’utilisation anonymes aident à améliorer WheelClick — elles ne contiennent aucune donnée personnelle. Les collecter coûte environ %@ d’énergie par jour — mesuré, comme tout le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche d’uso anonime aiutano a migliorare WheelClick: non contengono dati personali. Raccoglierle costa circa %@ di energia al giorno. Misurato, come tutto il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名の使用統計はWheelClickの改善に役立ちます。個人データは含まれません。収集にかかるエネルギーは1日あたり約%@。ほかのすべてと同じく、実測値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 사용 통계는 WheelClick을 개선하는 데 도움이 되며, 개인 정보는 포함하지 않습니다. 수집에 드는 에너지는 하루 약 %@입니다. 다른 모든 것처럼 실제로 측정한 값입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimowe statystyki użycia pomagają ulepszać WheelClick — nie zawierają danych osobowych. Ich zbieranie kosztuje około %@ energii dziennie — zmierzone, jak wszystko inne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estatísticas anônimas de uso ajudam a melhorar o WheelClick — elas não contêm dados pessoais. Coletá-las custa cerca de %@ de energia por dia — medido, como tudo o mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимная статистика использования помогает улучшать WheelClick — в ней нет личных данных. Ее сбор стоит около %@ энергии в день — измерено, как и все остальное."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonim kullanım istatistikleri WheelClick’i geliştirmeye yardımcı olur — kişisel veri içermez. Toplanması günde yaklaşık %@ enerjiye mal olur — diğer her şey gibi ölçülmüş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонімна статистика використання допомагає покращувати WheelClick — особистих даних у ній немає. Її збирання коштує близько %@ енергії на день — виміряно, як і все інше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thống kê sử dụng ẩn danh giúp cải thiện WheelClick — không chứa dữ liệu cá nhân. Việc thu thập tốn khoảng %@ năng lượng mỗi ngày — được đo thực tế, như mọi thứ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名使用统计有助于改进 WheelClick，其中不含任何个人数据。收集它们每天耗能约 %@——和其他一切一样，是实测值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名使用統計資料有助於改進 WheelClick，其中不含任何個人資料。收集這些資料每天耗能約 %@，和其他一切一樣，是實測值。"
          }
        }
      }
    },
