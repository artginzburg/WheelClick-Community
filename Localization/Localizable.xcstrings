            "value": "Ten klucz jest już aktywny na maksymalnej liczbie Maców. Dezaktywuj jeden w portalu klienta, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave já está ativa no número máximo de Macs. Desative um deles no portal do cliente e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ключ уже активен на максимальном числе Mac. Деактивируйте один в портале покупателя, затем попробуйте еще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtar zaten en fazla sayıda Mac’te etkin. Müşteri portalında birini devre dışı bırakın, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей ключ уже активний на максимальній кількості Mac. Деактивуйте один у порталі покупця, а потім спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa này đã được kích hoạt trên số máy Mac tối đa. Hãy hủy kích hoạt một máy trong cổng khách hàng, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥已在允许的最多数量的 Mac 上激活。请在客户门户中停用一台，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金鑰已在允許的最多數量的 Mac 上啟用。請在客戶入口網站中停用一台，然後再試一次。"
          }
        }
      }
    },
    "Three-Finger Click": {
      "comment": "Feature name: a middle click made by pressing the trackpad with three fingers. Used as a menu item and inside sentences",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick mit drei Fingern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic con tres dedos"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic con tres dedos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic à trois doigts"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic con tre dita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指クリック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 손가락 클릭"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknięcie trzema palcami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com Três Dedos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие тремя пальцами"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç Parmakla Tıklama"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацання трьома пальцями"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm bằng ba ngón tay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三指点按"
          }
        },
        "zh-Hant": {
