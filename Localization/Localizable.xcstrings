    "Take %@ off your Allow list.": {
      "comment": "Hover card of the 'Allow <app>' menu item; placeholder is an app name; the Allow list = apps WheelClick works in",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ von der Erlauben-Liste entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar %@ de tu lista de permitidas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar %@ de tu lista de permitidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire %@ de votre liste Autoriser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli %@ dal tuo elenco Consenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を許可リストから外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 앱을 허용 목록에서 제거합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z listy dozwolonych zniknie %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@ da sua lista de Permitidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать %@ из списка разрешенных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasını İzin listenizden çıkarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити %@ зі списку дозволених."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ %@ khỏi Danh sách cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 从允许列表中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 %@ 從允許列表移除。"
          }
        }
      }
    },
