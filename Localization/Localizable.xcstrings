          "stringUnit": {
            "state": "translated",
            "value": "fn + клацання входить до ліцензії. Клацання трьома пальцями й торкання трьома пальцями на трекпеді безкоштовні назавжди, і будь-яке з них завершує цей крок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "fn + bấm thuộc giấy phép. Bấm bằng ba ngón tay và chạm bằng ba ngón tay trên bàn di chuột là miễn phí vĩnh viễn, và một trong hai đều hoàn tất bước này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "fn + 点按属于许可证的一部分。触控板上的三指点按和三指轻点永远免费，任意一个都能完成这一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "fn + 按一下屬於授權的一部分。觸控式軌跡板上的三指按一下和三指點一下永遠免費，任何一個都能完成這一步。"
          }
        }
      }
    },
