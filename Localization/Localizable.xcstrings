    "Middle clicks from the mouse's surface.\nOnly affects the Magic Mouse —\nthe trackpad is untouched.": {
      "comment": "Gray caption at the top of the Magic Mouse submenu. Line breaks are manual (the menu widens rather than wraps): keep each line no longer than the submenu's item titles",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelklicks von der Mausoberfläche.\nBetrifft nur die Magic Mouse –\ndas Trackpad bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clics centrales desde la superficie del ratón.\nSolo afecta al Magic Mouse;\nel trackpad no cambia."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Clics centrales desde la superficie del mouse.\nSolo afecta al Magic Mouse;\nel trackpad no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clics centraux depuis la souris.\nUniquement sur la Magic Mouse —\nle trackpad reste intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic centrali dalla superficie del mouse.\nRiguarda solo il Magic Mouse:\nil trackpad non cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの表面からの中クリック。\nMagic Mouseにのみ影響し、\nトラックパッドには触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 표면에서 하는 가운데 클릭.\nMagic Mouse에만 적용되며\n트랙패드에는 영향이 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środkowe kliknięcia z powierzchni myszy.\nDotyczy tylko Magic Mouse —\ngładzik pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliques centrais pela superfície do mouse.\nAfeta apenas o Magic Mouse —\no trackpad não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средние клики с поверхности мыши.\nЗатрагивает только Magic Mouse —\nтрекпад не затронут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farenin yüzeyinden orta tıklamalar.\nYalnızca Magic Mouse’u etkiler —\nizleme dörtgenine dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середні клацання з поверхні миші.\nСтосується лише Magic Mouse —\nтрекпед залишається як є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột giữa từ mặt chuột.\nChỉ ảnh hưởng đến Magic Mouse —\nbàn di chuột không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自鼠标表面的中键点按。\n只影响妙控鼠标，\n触控板不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自滑鼠表面的中鍵點按。\n只影響巧控滑鼠，\n觸控式軌跡板不受影響。"
          }
        }
      }
    },
