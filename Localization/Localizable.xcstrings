          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm ngưng: “Kéo bằng ba ngón tay” của macOS hiện đang sở hữu cử chỉ ba ngón tay này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停：macOS 的三指拖移目前正掌管这个三指手势。"
          }
